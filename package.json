    "@mantine/hooks": "^9.4.1",
    "@mantine/notifications": "^9.4.1",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@tabler/icons-react": "^3.44.0",
    "@uiw/react-codemirror": "^4.25.11",
    "archiver": "^7.0.1",
    "i18next": "^26.3.6",
    "immer": "^11.1.11",
